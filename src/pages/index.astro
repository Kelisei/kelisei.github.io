---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

interface BlogPost {
	slug: string;
	data: {
		title: string;
		description: string;
		pubDate: Date;
		updatedDate?: Date;
		tags?: string[];
		project?: { id: string } | string;
	};
}

const siteTitle = import.meta.env.PUBLIC_SITE_TITLE || "Kelisei Ventura";
const authorName = import.meta.env.PUBLIC_AUTHOR_NAME || "Francisco Percara";
const role = import.meta.env.PUBLIC_ROLE || "Junior Software / Platform Engineer";
const company = import.meta.env.PUBLIC_COMPANY || "MetLife";
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL || "https://github.com/Kelisei";

const rawProjects = await getCollection('projects');
const projects = rawProjects.sort((a, b) => a.data.order - b.data.order);

const allBlogPosts = ((await getCollection('blog')) || []) as unknown as BlogPost[];
---

<Layout title={`${siteTitle} | Portfolio`}>
	<div class="space-y-16">
		<header class="space-y-4">
			<div class="space-y-2">
				<h1 class="text-4xl font-extrabold tracking-tight text-ctp-text sm:text-5xl">
					{siteTitle}
				</h1>
				<p class="text-xl font-medium text-ctp-lavender">
					{authorName}
				</p>
				<p class="text-lg text-ctp-subtext1">
					{role} at <span class="font-semibold text-ctp-mauve">{company}</span>
				</p>
			</div>
			<div class="flex items-center gap-4 text-sm">
				<a
					href={githubUrl}
					target="_blank"
					rel="noreferrer"
					class="font-medium text-ctp-lavender hover:text-ctp-mauve transition-colors"
				>
					GitHub &rarr;
				</a>
				<a
					href="#projects"
					class="font-medium text-ctp-subtext0 hover:text-ctp-text transition-colors"
				>
					Projects
				</a>
				<a
					href="/blog"
					class="font-medium text-ctp-subtext0 hover:text-ctp-text transition-colors"
				>
					Blog
				</a>
			</div>
		</header>

		<section id="projects" class="space-y-6">
			<div class="border-b border-ctp-surface0 pb-2">
				<h2 class="text-2xl font-bold tracking-tight text-ctp-text">
					Projects
				</h2>
			</div>

			<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
				{projects.map((project) => {
					const postCount = allBlogPosts.filter(
						(p) =>
							(typeof p.data.project === 'string' && p.data.project === project.id) ||
							(p.data.project && typeof p.data.project === 'object' && p.data.project.id === project.id)
					).length;
					const hasLink = project.data.href && project.data.href !== '#';
					const blogProjectUrl = `/blog?project=${project.id}`;
					return (
						<article class="flex flex-col overflow-hidden rounded-xl border border-ctp-surface0 bg-ctp-mantle transition-colors hover:border-ctp-surface1">
							<a href={blogProjectUrl} class="aspect-video w-full overflow-hidden bg-ctp-crust block group/image">
								<Image
									src={project.data.image}
									alt={project.data.alt}
									class="h-full w-full object-cover transition-transform duration-300 group-hover/image:scale-105"
								/>
							</a>
							<div class="flex flex-1 flex-col justify-between p-5 space-y-4">
								<div class="space-y-2">
									<div class="flex items-center justify-between gap-2">
										<a href={blogProjectUrl} class="group/title">
											<h3 class="text-xl font-semibold text-ctp-text group-hover/title:text-ctp-mauve transition-colors">
												{project.data.title}
											</h3>
										</a>
										{project.data.status && (
											<span class="rounded px-2 py-0.5 text-xs font-medium text-ctp-mauve bg-ctp-surface0">
												{project.data.status}
											</span>
										)}
									</div>
									<p class="text-sm leading-relaxed text-ctp-subtext0">
										{project.data.description}
									</p>
								</div>

								<div class="flex flex-wrap items-center gap-4">
									{hasLink && (
										<a
											href={project.data.href}
											target="_blank"
											rel="noreferrer"
											class="inline-flex items-center text-sm font-medium text-ctp-lavender hover:text-ctp-mauve transition-colors"
										>
											View Repository &rarr;
										</a>
									)}
									<a
										href={blogProjectUrl}
										class="inline-flex items-center text-sm font-medium text-ctp-mauve hover:text-ctp-pink transition-colors"
									>
										Devlogs {postCount > 0 ? `(${postCount})` : ''} &rarr;
									</a>
								</div>
							</div>
						</article>
					);
				})}
			</div>
		</section>
	</div>
</Layout>
